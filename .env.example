# Copy to .env.local. Never commit the populated file.
HOST=127.0.0.1
PORT=3002
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3000

# Fail closed by default. Use local ONLY for a trusted, single-user loopback server.
AUTH_MODE=supabase
# Optional, server-side only. Blank leaves paid AI features unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
# Optional comma-separated fallback and image generation models.
GEMINI_FALLBACK_MODELS=gemini-2.5-pro,gemini-2.5-flash,gemini-3.1-pro-preview,gemini-2.0-flash
GEMINI_IMAGE_MODELS=gemini-2.0-flash-exp-image-generation,gemini-2.0-flash-preview-image-generation,gemini-2.0-flash-exp

# Optional hosted authentication/collaboration. Use a NEW project for this edition.
# VITE_* values are public browser configuration. Never put service/secret keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=http://localhost:3000
# Same-origin /api is the default; Vite proxies to 127.0.0.1:3002.
VITE_API_URL=/api

# Experimental third-party photogrammetry, disabled until explicitly enabled.
ENABLE_POLYCAM=false
POLYCAM_API_KEY=
# Optional museum catalogue providers, server-side only.
EUROPEANA_API_KEY=
HARVARD_API_KEY=

# Production: set STATIC_DIR=dist after building. Use TLS at your reverse proxy.
# Leave proxy trust disabled unless a trusted proxy strips forwarded headers.
TRUST_PROXY=0
